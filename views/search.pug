      button#go-back(type='submit') Go back to profile
    div.container-center
      if bookmarks.length == 0
        section.bookmark  
          div No results found
      for bookmark in bookmarks
        section.bookmark  
          div
            div= bookmark.title
            div
              a(href=bookmark.url, target="blank")= bookmark.url
