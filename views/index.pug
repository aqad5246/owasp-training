html
  head
    link(rel='stylesheet', href='/styles.css')
    script(src='https://hunter2labs.s3.amazonaws.com/common.js')
  body
    .container-center
      h1.title Bookmarker
    .container-center
      section.card.container
        div.half
          p.center Log in
          form(action='/profile', method='post')
            input#email(type='email', name='logemail', placeholder='Your email', required)
            br
            input#password(type='password', name='logpassword', placeholder='Password', required)
            br
            button#log-in(type='submit') Log in
        div.bar= '\n'
        div.half
          p.center Register
          form(action='/profile', method='post')
            input#emailreg(type='email', name='email', placeholder='Your email', required)
            br
            input#passwordreg(type='password', name='password', placeholder='Password', required, minlength=8)
            br
            input#passwordConfreg(type='password', name='passwordConf', placeholder='Confirm password', required, minlength=8)
            br
            button(type='submit') Register